---
import Layout from '../../layouts/Layout.astro';
import { t } from '../../data/i18n';
const lang = 'en' as const;
const tt = t[lang];
---
<Layout lang={lang} title={tt.contact.title} section="contact">
  <section class="content-page">
    <div class="page-title fade-in">{tt.contact.title}</div>

    <div class="reveal">
      {tt.contact.lines.map(([label, value]) => (
        <div class="contact-row">
          <div class="muted">{label}</div>
          <div>{value}</div>
        </div>
      ))}
    </div>
  </section>
</Layout>
