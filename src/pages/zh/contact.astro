---
import Layout from '../../layouts/Layout.astro';
import { t } from '../../data/i18n';
const lang = 'zh' as const;
const tt = t[lang];
---
<Layout lang={lang} title={tt.contact.title} section="contact">
  <section style="padding: 30px; max-width: 760px;">
    <div style="margin-bottom: 30px;" class="fade-in">{tt.contact.title}</div>

    <div class="reveal">
      {tt.contact.lines.map(([label, value]) => (
        <div style="display: grid; grid-template-columns: 140px 1fr; gap: 20px; margin-bottom: 8px;">
          <div class="muted">{label}</div>
          <div>{value}</div>
        </div>
      ))}
    </div>
  </section>
</Layout>
