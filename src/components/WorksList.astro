---
import type { Lang } from '../data/i18n';
import { projects } from '../data/projects';
const { lang } = Astro.props as { lang: Lang };

const right = [
  { idx: 0, aspect: '3/2' },
  { idx: 2, aspect: '3/2' },
  { idx: 4, aspect: '4/3' }
];
const left = [
  { idx: 1, aspect: '3/4' },
  { idx: 3, aspect: '3/2' },
  { idx: 5, aspect: '3/2' }
];

const renderItem = (slot: { idx: number; aspect: string }) => {
  const p = projects[slot.idx];
  return { p, aspect: slot.aspect };
};
---
<div class="curated">
  <div class="col col-left">
    {left.map((s) => {
      const { p, aspect } = renderItem(s);
      return (
        <a class="item" href={`/${lang}/works/${p.slug}`}>
          <div class="frame" style={`aspect-ratio: ${aspect};`}>
            <img src={`/works/${p.slug}/01.jpg`} alt={p.venue[lang]} loading="lazy" />
          </div>
          <div class="caption">
            <span>{p.poeticTitle[lang]}</span>
            <span class="sep">|</span>
            <span>{p.venue[lang]}</span>
          </div>
        </a>
      );
    })}
  </div>

  <div class="col col-right">
    {right.map((s) => {
      const { p, aspect } = renderItem(s);
      return (
        <a class="item" href={`/${lang}/works/${p.slug}`}>
          <div class="frame" style={`aspect-ratio: ${aspect};`}>
            <img src={`/works/${p.slug}/01.jpg`} alt={p.venue[lang]} loading="lazy" />
          </div>
          <div class="caption">
            <span>{p.poeticTitle[lang]}</span>
            <span class="sep">|</span>
            <span>{p.venue[lang]}</span>
          </div>
        </a>
      );
    })}
  </div>
</div>
