---
import type { Lang } from '../data/i18n';
import { getProjectCategorySlug, projects, type WorkCategorySlug } from '../data/projects';
const { lang, category = 'selected' } = Astro.props as { lang: Lang; category?: WorkCategorySlug };

const aspectPattern = ['3/2', '3/4', '6/5', '4/3', '3/2', '5/4'];
const buildColumns = (groupProjects: typeof projects) => {
  const slots = groupProjects.map((project, index) => ({
    project,
    aspect: aspectPattern[index % aspectPattern.length],
    column: index % 2 === 0 ? 1 : 0
  }));
  return [0, 1].map((column) => slots.filter((slot) => slot.column === column));
};

const projectGroups = category === 'selected'
  ? [
      projects.filter((project) => getProjectCategorySlug(project) === 'selected'),
      projects.filter((project) => getProjectCategorySlug(project) !== 'selected')
    ]
  : [projects.filter((project) => getProjectCategorySlug(project) === category)];

const stripYear = (name: string) => name.replace(/^\d{4}\s+/, '');
---
{projectGroups.map((groupProjects, groupIndex) => (
  <div class:list={['curated', groupIndex > 0 ? 'curated-following' : '']} data-category={category}>
    {buildColumns(groupProjects).map((columnSlots, columnIndex) => (
      <div class={`col col-${columnIndex + 1}`}>
        {columnSlots.map((s) => {
          const { project: p, aspect } = s;
          return (
            <a class="item" href={`/${lang}/works/${p.slug}`}>
              <div class="frame" style={`aspect-ratio: ${aspect};`}>
                <img src={p.cover} alt={stripYear(p.name)} loading="lazy" decoding="async" />
              </div>
              <div class="caption">
                <span>{stripYear(p.name)}</span>
              </div>
            </a>
          );
        })}
      </div>
    ))}
  </div>
))}
