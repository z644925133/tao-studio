---
import type { Lang } from '../data/i18n';
import { imageSrcSet, imageUrl } from '../data/image-cdn';
import { getProjectCategorySlug, projects, type WorkCategorySlug } from '../data/projects';
const { lang, category = 'selected' } = Astro.props as { lang: Lang; category?: WorkCategorySlug };

const aspectPattern = ['3/2', '3/4', '6/5', '4/3', '3/2', '5/4'];
const buildColumns = (groupProjects: typeof projects) => {
  const slots = groupProjects.map((project, index) => ({
    project,
    aspect: aspectPattern[index % aspectPattern.length],
    column: index % 2 === 0 ? 1 : 0
  }));
  return [0, 1].map((column) => slots.filter((slot) => slot.column === column));
};

const selectedGroup = projects.filter((project) => getProjectCategorySlug(project) === 'selected');
const followingGroup = projects.filter((project) => getProjectCategorySlug(project) !== 'selected');
const visibleGroups = category === 'selected'
  ? [selectedGroup]
  : [projects.filter((project) => getProjectCategorySlug(project) === category)];
const shouldLoadFollowing = category === 'selected' && followingGroup.length > 0;

const stripYear = (name: string) => name.replace(/^\d{4}\s+/, '');
---
{visibleGroups.map((groupProjects, groupIndex) => (
  <div class:list={['curated', groupIndex > 0 ? 'curated-following' : '']} data-category={category}>
    {buildColumns(groupProjects).map((columnSlots, columnIndex) => (
      <div class={`col col-${columnIndex + 1}`}>
        {columnSlots.map((s) => {
          const { project: p, aspect } = s;
          return (
            <a class="item" href={`/${lang}/works/${p.slug}`}>
              <div class="frame" style={`aspect-ratio: ${aspect};`}>
                <img
                  src={imageUrl(p.cover, { w: 720, q: 66, fit: 'cover' })}
                  srcset={imageSrcSet(p.cover, [420, 640, 720, 900], { q: 66, fit: 'cover' })}
                  sizes="(min-width: 769px) 38vw, 100vw"
                  alt={stripYear(p.name)}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="caption">
                <span>{stripYear(p.name)}</span>
              </div>
            </a>
          );
        })}
      </div>
    ))}
  </div>
))}

{shouldLoadFollowing && (
  <>
    <div class="works-load-sentinel" data-works-load-sentinel aria-hidden="true"></div>
    <noscript>
      <div class="works-noscript">
        <p>{lang === 'zh' ? '继续浏览其它项目，请进入各项目类型。' : 'Continue browsing through the project categories.'}</p>
        <a href={`/${lang}/works/category/residential`}>{lang === 'zh' ? '住宅' : 'Residential'}</a>
        <a href={`/${lang}/works/category/office`}>{lang === 'zh' ? '办公' : 'Office'}</a>
        <a href={`/${lang}/works/category/commercial`}>{lang === 'zh' ? '商业' : 'Commercial'}</a>
        <a href={`/${lang}/works/category/exhibition`}>{lang === 'zh' ? '展示' : 'Exhibition'}</a>
        <a href={`/${lang}/works/category/hotel`}>{lang === 'zh' ? '酒店' : 'Hotel'}</a>
      </div>
    </noscript>
    <script is:inline>
      (() => {
        const sentinel = document.querySelector('[data-works-load-sentinel]');
        if (!sentinel) return;
        const lang = document.documentElement.lang === 'en' ? 'en' : 'zh';

        const createItem = (item) => {
          const link = document.createElement('a');
          link.className = 'item';
          link.href = `/${lang}/works/${item.slug}`;

          const frame = document.createElement('div');
          frame.className = 'frame';
          frame.style.aspectRatio = item.aspect;

          const img = document.createElement('img');
          img.src = item.cover;
          if (item.srcset) img.srcset = item.srcset;
          img.sizes = '(min-width: 769px) 38vw, 100vw';
          img.alt = item.name;
          img.loading = 'lazy';
          img.decoding = 'async';

          const caption = document.createElement('div');
          caption.className = 'caption';

          const name = document.createElement('span');
          name.textContent = item.name;

          frame.append(img);
          caption.append(name);
          link.append(frame, caption);
          return link;
        };

        const loadFollowingWorks = async () => {
          if (sentinel.hasAttribute('data-loaded')) return;
          sentinel.setAttribute('data-loaded', 'true');

          const response = await fetch('/api/works-following.json');
          if (!response.ok) {
            sentinel.removeAttribute('data-loaded');
            return;
          }

          const data = await response.json();
          const columns = [[], []];
          data.items.forEach((item) => {
            columns[item.column === 1 ? 1 : 0].push(item);
          });

          const group = document.createElement('div');
          group.className = 'curated curated-following';
          group.dataset.category = 'following';

          columns.forEach((items, index) => {
            const col = document.createElement('div');
            col.className = `col col-${index + 1}`;
            items.forEach((item) => col.append(createItem(item)));
            group.append(col);
          });

          sentinel.parentNode?.insertBefore(group, sentinel);
          sentinel.remove();
        };

        const hasScrolledIntoFollowing = () => window.scrollY > Math.min(360, window.innerHeight * 0.45);
        let userScrolled = hasScrolledIntoFollowing();

        const loadAfterScroll = () => {
          if (userScrolled) return;
          userScrolled = hasScrolledIntoFollowing();
          if (!userScrolled) return;
          loadFollowingWorks().catch(() => sentinel.removeAttribute('data-loaded'));
        };

        if ('IntersectionObserver' in window) {
          const io = new IntersectionObserver((entries) => {
            if (userScrolled && entries.some((entry) => entry.isIntersecting)) {
              io.disconnect();
              loadFollowingWorks().catch(() => sentinel.removeAttribute('data-loaded'));
            }
          }, { rootMargin: '240px 0px', threshold: 0 });
          io.observe(sentinel);

          window.addEventListener('scroll', () => {
            userScrolled = hasScrolledIntoFollowing();
            if (userScrolled && sentinel.getBoundingClientRect().top < window.innerHeight + 240) {
              io.disconnect();
              loadFollowingWorks().catch(() => sentinel.removeAttribute('data-loaded'));
            }
          }, { passive: true, once: false });
        } else if ('requestIdleCallback' in window) {
          window.addEventListener('scroll', () => requestIdleCallback(loadAfterScroll, { timeout: 1200 }), { passive: true });
        } else {
          window.addEventListener('scroll', () => window.setTimeout(loadAfterScroll, 300), { passive: true });
        }
      })();
    </script>
  </>
)}
