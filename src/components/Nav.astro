---
import { t, type Lang } from '../data/i18n';
import { workCategories, type WorkCategorySlug } from '../data/projects';
const { lang, section = 'home', category = 'selected' } = Astro.props as {
  lang: Lang;
  section?: 'works' | 'about' | 'contact' | 'home';
  category?: WorkCategorySlug;
};
const tt = t[lang];
const other = lang === 'zh' ? 'en' : 'zh';
const otherLabel = lang === 'zh' ? 'EN' : '中';
const currentPath = Astro.url.pathname;
const switchPath = currentPath.replace(/^\/(zh|en)/, `/${other}`) || `/${other}/`;
const categoryHref = (slug: WorkCategorySlug) => (
  slug === 'selected' ? `/${lang}/works` : `/${lang}/works/category/${slug}`
);
const drawerCategoryLabel = lang === 'zh' ? '作品分类' : 'Work Categories';

// Hide default rules: items not matching the current section are dimmed (opacity 0)
// until the user hovers over the entire sidebar — mirrors Neri&Hu's behaviour.
const hideClass = (target: string) => (section === 'home' || section === target ? '' : 'hide-default');
const languageClass = section === 'home' ? '' : 'hide-default';
---
<div class="sidebar-fixed">
  <!-- brand — always visible -->
  <div class="logos">
    <a href={`/${lang}/`}>{tt.site.brandZh}</a>
    <a href={`/${lang}/`}>{tt.site.brandEn}</a>
  </div>

  <!-- desktop nav -->
  <nav class="nav-desktop">
    <ul>
      <li class={hideClass('works')}>
        <a href={`/${lang}/works`} aria-current={section === 'works' ? 'page' : undefined}>{tt.nav.works}</a>
      </li>
      <li class={hideClass('about')}>
        <a href={`/${lang}/about`} aria-current={section === 'about' ? 'page' : undefined}>{tt.nav.about}</a>
      </li>
      <li class={hideClass('contact')}>
        <a href={`/${lang}/contact`} aria-current={section === 'contact' ? 'page' : undefined}>{tt.nav.contact}</a>
      </li>
      <li class={languageClass}><a href={switchPath}>{otherLabel}</a></li>
    </ul>
    {section === 'works' && (
      <ul class="subnav-current">
        {workCategories.map((item) => (
          <li class={item.slug === category ? '' : 'hide-default'}>
            <a href={categoryHref(item.slug)} aria-current={item.slug === category ? 'page' : undefined}>
              {item.label[lang]}
            </a>
          </li>
        ))}
      </ul>
    )}
  </nav>

  <!-- mobile: hamburger button -->
  <button class="nav-burger" aria-label="菜单" aria-expanded="false" aria-controls="mobile-drawer">
    <span></span><span></span>
  </button>
</div>

<!-- mobile drawer overlay -->
<div id="mobile-drawer" class="mobile-drawer" aria-hidden="true">
  <nav class="drawer-nav">
    <div class="drawer-work-group">
      <a href={`/${lang}/works`} class="drawer-primary-link">{tt.nav.works}</a>
      <div class="drawer-category-label">{drawerCategoryLabel}</div>
      <div class="drawer-category-list">
        {workCategories.map((item) => (
          <a href={categoryHref(item.slug)} aria-current={section === 'works' && item.slug === category ? 'page' : undefined}>
            {item.label[lang]}
          </a>
        ))}
      </div>
    </div>
    <a href={`/${lang}/about`}>{tt.nav.about}</a>
    <a href={`/${lang}/contact`}>{tt.nav.contact}</a>
    <a href={switchPath} class="lang-switch">{otherLabel}</a>
  </nav>
</div>

<style>
  /* hamburger — mobile only */
  .nav-burger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px 4px 8px 10px;
  }
  .nav-burger span {
    display: block;
    width: 100%;
    height: 1px;
    background: var(--fg);
    transition: transform 0.25s ease, opacity 0.25s ease;
  }
  /* X state */
  .nav-burger[aria-expanded="true"] span:first-child {
    transform: translateY(6px) rotate(45deg);
  }
  .nav-burger[aria-expanded="true"] span:last-child {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* drawer */
  .mobile-drawer {
    display: none;
    position: fixed;
    inset: var(--nav-h) 0 0 0;
    background: var(--bg);
    z-index: 99;
    overflow-y: auto;
    padding: 28px var(--pad-x) calc(36px + env(safe-area-inset-bottom));
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .mobile-drawer.open {
    display: block;
    opacity: 1;
  }
  .drawer-nav {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .drawer-nav a {
    display: block;
    font-size: clamp(1.35rem, 7vw, 2.05rem);
    letter-spacing: 0.06em;
    padding: 17px 0;
    border-bottom: 1px solid var(--line);
    color: var(--fg);
  }
  .drawer-work-group {
    padding-bottom: 18px;
    border-bottom: 1px solid var(--line);
  }
  .drawer-work-group .drawer-primary-link {
    border-bottom: none;
    padding-bottom: 10px;
  }
  .drawer-category-label {
    margin: 0 0 11px;
    color: var(--muted);
    font-size: 11px;
    line-height: 1;
    letter-spacing: 0.14em;
  }
  .drawer-category-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px 14px;
  }
  .drawer-category-list a {
    min-height: 34px;
    padding: 7px 0;
    border-bottom: none;
    color: var(--muted);
    font-size: 13px;
    line-height: 20px;
    letter-spacing: 0.04em;
  }
  .drawer-category-list a[aria-current="page"] {
    color: var(--fg);
  }
  .drawer-nav .lang-switch {
    margin-top: 32px;
    border-bottom: none;
    font-size: 1rem;
    color: var(--muted);
  }

  /* desktop: hide hamburger and drawer */
  @media (min-width: 769px) {
    .nav-burger { display: none; }
    .mobile-drawer { display: none !important; }
    .nav-desktop { display: block; }
  }
  /* mobile: hide desktop nav */
  @media (max-width: 768px) {
    .nav-desktop { display: none; }
    .nav-burger {
      margin-right: -4px;
    }
  }
</style>

<script>
  const burger = document.querySelector('.nav-burger') as HTMLButtonElement | null;
  const drawer = document.getElementById('mobile-drawer');
  if (burger && drawer) {
    burger.addEventListener('click', () => {
      const open = burger.getAttribute('aria-expanded') === 'true';
      burger.setAttribute('aria-expanded', String(!open));
      drawer.setAttribute('aria-hidden', String(open));
      drawer.classList.toggle('open', !open);
    });
    // close on link click
    drawer.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', () => {
        burger.setAttribute('aria-expanded', 'false');
        drawer.setAttribute('aria-hidden', 'true');
        drawer.classList.remove('open');
      });
    });
  }
</script>
