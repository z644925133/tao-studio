---
import type { Lang } from '../data/i18n';
import { homeSlides } from '../data/projects';
const { lang } = Astro.props as { lang: Lang };
const stripYear = (name: string) => name.replace(/^\d{4}\s+/, '');
---
<!--
  Restrained slideshow, top-right aligned within the main canvas.
  The proportions intentionally echo the reference site's right-weighted media field.
-->
<section class="home-hero">
  <div class="home-hero-frame">
    <div class="crossfade home-crossfade">
      {homeSlides.map(({ project, image }, i) => (
        <a
          href={`/${lang}/works/${project.slug}`}
          class:list={[i === 0 ? 'active' : '']}
          data-slide={i}
          aria-label={stripYear(project.name)}
        >
          <img
            src={image}
            alt={stripYear(project.name)}
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'auto'}
            decoding="async"
          />
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .home-hero {
    height: 100vh;
    padding: 30px 30px 30px 0;
    box-sizing: border-box;
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
  }
  .home-hero-frame {
    width: 71.2%;
    aspect-ratio: 16 / 9;
    max-height: calc(100vh - 60px);
    overflow: hidden;
    background: #f5f5f5;
  }
  .home-crossfade {
    position: relative;
    width: 100%;
    height: 100%;
  }
  @media (max-width: 768px) {
    .home-hero {
      height: auto;
      padding: 15px;
    }
    .home-hero-frame {
      width: 100%;
      aspect-ratio: 16 / 9;
      max-height: none;
    }
  }
</style>

<script is:inline define:vars={{ count: homeSlides.length }}>
  const slides = document.querySelectorAll('.home-crossfade > a');
  let idx = 0;
  setInterval(() => {
    if (!slides.length) return;
    slides[idx].classList.remove('active');
    idx = (idx + 1) % count;
    slides[idx].classList.add('active');
  }, 3000);
</script>
