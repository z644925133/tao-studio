---
import type { Lang } from '../data/i18n';
import { projects, type Project } from '../data/projects';
import { t } from '../data/i18n';

type Props = { lang: Lang; project: Project };
const { lang, project } = Astro.props;
const tt = t[lang];
const sectionLabels = lang === 'zh'
  ? { images: '图像', text: '文本', information: '信息', related: '相关' }
  : { images: 'Images', text: 'Text', information: 'Information', related: 'Related' };
const images = Array.from(
  { length: project.imageCount },
  (_, i) => `/works/${project.slug}/${String(i + 1).padStart(2, '0')}.jpg`
);
const metaRows = [
  [tt.works.meta.type, project.type[lang]],
  [tt.works.meta.area, project.meta.area],
  [tt.works.meta.status, project.meta.status[lang]],
  [tt.works.meta.completion, project.meta.completion[lang]],
  [tt.works.meta.duration, project.meta.duration[lang]],
  [tt.works.meta.location, project.meta.location[lang]]
];
const relatedProjects = projects.filter((p) => p.slug !== project.slug).slice(0, 3);
---

<article class="project-detail" data-project-detail>
  <aside class="project-switcher" aria-label={project.venue[lang]}>
    <div class="project-switcher-title">
      <span>{project.poeticTitle[lang]}</span>
      <span class="muted"> | </span>
      <span>{project.venue[lang]}</span>
    </div>
    <a href="#project-images">{sectionLabels.images}</a>
    <a href="#project-text">{sectionLabels.text}</a>
    <a href="#project-information">{sectionLabels.information}</a>
    <a href="#project-related">{sectionLabels.related}</a>
  </aside>

  <div class="project-stage">
    <section id="project-images" class="project-section project-images" aria-label={sectionLabels.images}>
      {images.map((src, index) => (
        <figure class:list={['project-media', index === 0 ? 'project-media-lead' : '']}>
          <img
            src={src}
            alt={`${project.venue[lang]} ${String(index + 1).padStart(2, '0')}`}
            loading={index === 0 ? 'eager' : 'lazy'}
            fetchpriority={index === 0 ? 'high' : 'auto'}
          />
        </figure>
      ))}
    </section>

    <section id="project-text" class="project-section project-text" aria-label={sectionLabels.text}>
      <div class="project-kicker muted">{project.type[lang]}</div>
      <h1>{project.poeticTitle[lang]} <span class="muted">|</span> {project.venue[lang]}</h1>
      {project.description[lang].map((para) => (
        <p>{para}</p>
      ))}
    </section>

    <section id="project-information" class="project-section project-information" aria-label={sectionLabels.information}>
      <div class="info-grid">
        {metaRows.map(([label, value]) => (
          <div class="info-row">
            <div class="muted">{label}</div>
            <div>{value}</div>
          </div>
        ))}
      </div>
    </section>

    <section id="project-related" class="project-section project-related" aria-label={sectionLabels.related}>
      <div class="related-grid">
        {relatedProjects.map((p) => (
          <a href={`/${lang}/works/${p.slug}`}>
            <div class="related-frame">
              <img src={`/works/${p.slug}/01.jpg`} alt={p.venue[lang]} loading="lazy" />
            </div>
            <div>
              <span>{p.poeticTitle[lang]}</span>
              <span class="muted"> | </span>
              <span>{p.venue[lang]}</span>
            </div>
          </a>
        ))}
      </div>
      <a class="project-back muted" href={`/${lang}/works`}>-&gt; {tt.works.back}</a>
    </section>
  </div>
</article>

<style>
  .project-detail {
    position: relative;
    min-height: 100vh;
  }
  .project-switcher {
    position: fixed;
    left: 30px;
    bottom: 30px;
    width: 190px;
    z-index: 55;
  }
  .project-switcher-title {
    margin-bottom: 18px;
  }
  .project-switcher a {
    display: block;
    width: 100%;
    height: 20px;
    color: var(--muted);
    line-height: 20px;
  }
  .project-switcher a:hover {
    color: var(--fg);
    opacity: 1;
  }
  .project-stage {
    padding: 30px 30px 110px 0;
  }
  .project-section {
    scroll-margin-top: 30px;
  }
  .project-section + .project-section {
    margin-top: 118px;
  }
  .project-media {
    width: 79.2%;
    margin: 0 0 30px 0;
    overflow: hidden;
    background: #f5f5f5;
  }
  .project-media-lead {
    width: 79.2%;
  }
  .project-media img,
  .related-frame img {
    width: 100%;
    height: auto;
  }
  .project-text,
  .project-information {
    max-width: 640px;
  }
  .project-text h1 {
    margin-bottom: 32px;
  }
  .project-kicker {
    margin-bottom: 20px;
  }
  .project-text p {
    margin-bottom: 20px;
  }
  .info-grid {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr);
    row-gap: 8px;
    column-gap: 30px;
  }
  .info-row {
    display: contents;
  }
  .related-grid {
    width: 79.2%;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 30px;
  }
  .related-frame {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: #f5f5f5;
    margin-bottom: 11px;
  }
  .related-frame img {
    height: 100%;
    object-fit: cover;
  }
  .project-back {
    display: inline-block;
    margin-top: 40px;
  }
  @media (max-width: 768px) {
    .project-switcher {
      position: sticky;
      top: var(--mobile-nav-h);
      left: auto;
      bottom: auto;
      width: auto;
      padding: 15px;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
    }
    .project-switcher-title {
      margin-bottom: 10px;
    }
    .project-switcher a {
      display: inline-block;
      width: auto;
      margin-right: 16px;
    }
    .project-stage {
      padding: 15px 15px 60px;
    }
    .project-section {
      scroll-margin-top: calc(var(--mobile-nav-h) + 76px);
    }
    .project-section + .project-section {
      margin-top: 60px;
    }
    .project-media,
    .project-media-lead,
    .related-grid {
      width: 100%;
    }
    .info-grid {
      display: block;
    }
    .info-row {
      display: grid;
      grid-template-columns: 110px minmax(0, 1fr);
      column-gap: 20px;
      margin-bottom: 8px;
    }
    .related-grid {
      display: block;
    }
    .related-grid a {
      display: block;
      margin-bottom: 30px;
    }
  }
</style>
