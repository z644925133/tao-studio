---
import type { Lang } from '../data/i18n';
import { imageSrcSet, imageUrl } from '../data/image-cdn';
import { projects, type Project } from '../data/projects';

type Props = { lang: Lang; project: Project };
const { lang, project } = Astro.props;
const sectionLabels = lang === 'zh'
  ? { images: '图像', plans: '平面布置图', text: '项目介绍', related: '相关' }
  : { images: 'Images', plans: 'Plans', text: 'Description', related: 'Related' };
const relatedProjects = projects
  .filter((p) => p.slug !== project.slug && p.category === project.category)
  .slice(0, 3);
const stripYear = (name: string) => name.replace(/^\d{4}\s+/, '');
const displayName = stripYear(project.name);
---

<article class="project-detail" data-project-detail>
  <aside class="project-switcher" aria-label={displayName}>
    <div class="project-switcher-title">
      <span>{displayName}</span>
    </div>
    <a href="#project-images">{sectionLabels.images}</a>
    {project.plans.length > 0 && <a href="#project-plans">{sectionLabels.plans}</a>}
    <a href="#project-text">{sectionLabels.text}</a>
    <a href="#project-related">{sectionLabels.related}</a>
  </aside>

  <div class="project-stage">
    <section id="project-images" class="project-section project-images" aria-label={sectionLabels.images}>
      {project.images.map((src, index) => (
        <figure class:list={['project-media', index === 0 ? 'project-media-lead' : '']}>
          <img
            src={imageUrl(src, { w: 1600, q: 70 })}
            srcset={imageSrcSet(src, [720, 1080, 1400, 1600], { q: 70 })}
            sizes="(min-width: 769px) 68vw, 100vw"
            alt={`${displayName} ${String(index + 1).padStart(2, '0')}`}
            loading={index === 0 ? 'eager' : 'lazy'}
            fetchpriority={index === 0 ? 'high' : 'auto'}
            decoding="async"
          />
        </figure>
      ))}
    </section>

    {project.plans.length > 0 && (
      <section id="project-plans" class="project-section project-plans" aria-label={sectionLabels.plans}>
        <h2 class="project-heading muted">{sectionLabels.plans}</h2>
        {project.plans.map((src, index) => (
          <figure class="project-media project-plan">
            <img
              src={imageUrl(src, { w: 1400, q: 76 })}
              srcset={imageSrcSet(src, [720, 1080, 1400], { q: 76 })}
              sizes="(min-width: 769px) 68vw, 100vw"
              alt={`${displayName} plan ${index + 1}`}
              loading="lazy"
              decoding="async"
            />
          </figure>
        ))}
      </section>
    )}

    <section id="project-text" class="project-section project-text" aria-label={sectionLabels.text}>
      <div class="project-meta">
        <span class="project-title-main">{displayName}</span>
        <span class="project-year-tag">{project.year}</span>
      </div>
      <div class="project-desc-grid">
        {project.description?.zh && (
          <div class="desc-zh">
            <p>{project.description.zh}</p>
          </div>
        )}
        {project.description?.en && (
          <div class="desc-en">
            <p>{project.description.en}</p>
          </div>
        )}
      </div>
    </section>

    <section id="project-related" class="project-section project-related" aria-label={sectionLabels.related}>
      <div class="related-grid">
        {relatedProjects.map((p) => (
          <a href={`/${lang}/works/${p.slug}`}>
            <div class="related-frame">
              <img
                src={imageUrl(p.cover, { w: 640, q: 66, fit: 'cover' })}
                srcset={imageSrcSet(p.cover, [360, 520, 640, 800], { q: 66, fit: 'cover' })}
                sizes="(min-width: 769px) 22vw, 50vw"
                alt={stripYear(p.name)}
                loading="lazy"
                decoding="async"
              />
            </div>
            <div>
              <span>{stripYear(p.name)}</span>
            </div>
          </a>
        ))}
      </div>
      <a class="project-back muted" href={`/${lang}/works`}>— {lang === 'zh' ? '返回全部' : 'Back to all'}</a>
    </section>
  </div>
</article>

<style>
  /* ── mobile-first base ── */
  .project-detail { position: relative; min-height: 100vh; }

  /* switcher hidden on mobile */
  .project-switcher { display: none; }

  .project-stage {
    padding: var(--pad-x) var(--pad-x) 72px;
  }
  .project-section { scroll-margin-top: calc(var(--nav-h) + 8px); }
  .project-section + .project-section { margin-top: 56px; }

  /* images full-width on mobile */
  .project-media {
    width: 100%;
    margin: 0 0 12px 0;
    overflow: hidden;
    background: #f5f5f5;
  }
  .project-media img,
  .related-frame img {
    width: 100%;
    height: auto;
  }
  .project-heading {
    margin-bottom: 14px;
    font-size: 11px;
    letter-spacing: 0.16em;
    font-weight: 400;
  }
  .project-plan { background: #fff; padding: 8px; }

  /* text block */
  .project-text { width: 100%; }
  .project-meta {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-bottom: 20px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
  }
  .project-title-main {
    font-size: 1rem;
    font-weight: 400;
    letter-spacing: 0.06em;
  }
  .project-year-tag {
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--muted);
  }
  /* single column on mobile */
  .project-desc-grid { display: block; }
  .desc-zh { margin-bottom: 20px; }
  .desc-zh p, .desc-en p {
    margin: 0;
    font-size: 13px;
    line-height: 1.9;
    letter-spacing: 0.04em;
  }
  .desc-zh p { color: var(--fg); }
  .desc-en p { color: var(--muted); }

  /* related — single column on mobile */
  .related-grid {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .related-frame {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: #f5f5f5;
    margin-bottom: 8px;
  }
  .related-frame img { height: 100%; object-fit: cover; }
  .project-back {
    display: inline-block;
    margin-top: 32px;
    font-size: 12px;
    letter-spacing: 0.1em;
  }

  @media (max-width: 768px) {
    .project-stage {
      padding: 12px var(--pad-x) 68px;
    }
    .project-section + .project-section {
      margin-top: 48px;
    }
    .project-media {
      margin-bottom: 10px;
    }
    .project-media img {
      min-height: 1px;
    }
    .project-plan {
      padding: 10px;
      border: 1px solid var(--line);
    }
    .project-heading {
      margin-bottom: 12px;
      font-size: 10px;
    }
    .project-meta {
      display: block;
      margin-bottom: 18px;
      padding-bottom: 13px;
    }
    .project-title-main {
      display: block;
      font-size: 15px;
      line-height: 1.45;
      letter-spacing: 0.04em;
    }
    .project-year-tag {
      display: block;
      margin-top: 5px;
      font-size: 10px;
    }
    .desc-zh {
      margin-bottom: 18px;
    }
    .desc-zh p,
    .desc-en p {
      font-size: 13px;
      line-height: 1.85;
      letter-spacing: 0.02em;
    }
    .related-grid {
      gap: 14px 12px;
    }
    .related-grid a {
      font-size: 12px;
      line-height: 1.45;
    }
    .project-back {
      margin-top: 30px;
      padding: 8px 0;
    }
  }

  /* ── desktop enhancements ── */
  @media (min-width: 769px) {
    .project-switcher {
      display: block;
      position: fixed;
      left: 30px;
      bottom: 30px;
      width: 160px;
      z-index: 55;
    }
    .project-switcher-title {
      margin-bottom: 16px;
      font-size: 12px;
      letter-spacing: 0.06em;
    }
    .project-switcher a {
      display: block;
      height: 20px;
      line-height: 20px;
      font-size: 12px;
      color: var(--muted);
    }
    .project-switcher a:hover { color: var(--fg); opacity: 1; }

    .project-stage { padding: 30px 30px 110px 0; }
    .project-section { scroll-margin-top: 30px; }
    .project-section + .project-section { margin-top: 100px; }

    .project-media { width: 79.2%; margin-bottom: 28px; }
    .project-media-lead { width: 79.2%; }
    .project-plan { padding: 16px; }

    .project-text { max-width: 79.2%; }
    .project-meta { gap: 20px; margin-bottom: 28px; padding-bottom: 16px; }
    .project-title-main { font-size: clamp(0.95rem, 1.4vw, 1.15rem); letter-spacing: 0.08em; }

    .project-desc-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 0 56px;
    }
    .desc-zh { margin-bottom: 0; }

    .related-grid {
      width: 79.2%;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 30px;
    }
    .related-frame { margin-bottom: 11px; }
    .project-back { margin-top: 40px; }
  }
</style>
